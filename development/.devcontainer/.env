# Customize this file in your copied development environment before startup.
# Dev Containers derives the Compose project name from the environment folder:
# environments/task-a becomes task-a_devcontainer. Keep that folder name stable.
# Give parallel environments different host ports and their own workspace copies.
FRAPPE_T3_PORT=3774
# T3 npm channel: latest (stable) or nightly.
FRAPPE_T3_CHANNEL=latest
# Chrome's sandbox needs user namespaces blocked by Docker's default profile.
# Set to 1 only when your Docker runtime supports Chrome's sandbox.
FRAPPE_T3_BROWSER_SANDBOX=0
FRAPPE_HTTP_PORT=8000
FRAPPE_REALTIME_PORT=9000

# Paths are inside the container, relative to /workspace/development.
# These inputs are passed directly to installer.py in the copied environment.
FRAPPE_APPS_JSON=apps-example.json
FRAPPE_BENCH_NAME=frappe-bench
FRAPPE_SITE_NAME=development.localhost
# Set to 0 to omit Bench's --dev flag when creating a new Bench.
FRAPPE_BENCH_DEV=1

# Optional: seed new environments from your local T3 preferences.
# FRAPPE_T3_SETTINGS_FILE=/absolute/path/to/.t3/userdata/settings.json
